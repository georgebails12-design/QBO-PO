# QuickBooks credentials/tokens/cache -- never commit these
qbo_config.json
qbo_tokens.json
qbo_reference_cache.json

# PO request queue (submitted by users on the server)
po_requests.json
po_requests.json.*

# Local login accounts -- never commit real credentials
users.json

# Generated Cardinal order CSVs
downloads/

__pycache__/
*.pyc

# Persisted Flask session key -- never commit
flask_secret_key

# Public request form: link key and files people attach -- never commit
form_key
request_uploads/
